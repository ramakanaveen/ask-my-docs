# =============================================================================
# Ask My Docs - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=Ask My Docs
DEBUG=False
VERSION=1.0.0
ENVIRONMENT=development  # development, staging, production

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://askmydocs:password@localhost:5432/askmydocs
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# For async database operations
DATABASE_URL_ASYNC=postgresql+asyncpg://askmydocs:password@localhost:5432/askmydocs

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
SECRET_KEY=your-secret-key-here-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# -----------------------------------------------------------------------------
# LLM Configuration (Google Vertex AI)
# -----------------------------------------------------------------------------
# Google Cloud service account credentials
# Get your credentials from: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_CREDENTIALS_PATH=/path/to/your/service-account-key.json
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_LOCATION=us-central1  # Vertex AI location for LLM
GOOGLE_EMBEDDING_LOCATION=us-central1  # Vertex AI location for embeddings

# Gemini model settings
GEMINI_MODEL_NAME=gemini-2.5-pro
GEMINI_TEMPERATURE=0.2
GEMINI_TOP_P=0.95

# Embedding model
GOOGLE_EMBEDDING_MODEL_NAME=text-embedding-005

# Alternative providers (Optional)
ANTHROPIC_API_KEY=your-anthropic-api-key  # Optional
OPENAI_API_KEY=your-openai-api-key  # Optional

# LLM Provider Selection
LLM_PROVIDER=google  # google, anthropic, or openai
EMBEDDING_PROVIDER=google  # google or openai

# -----------------------------------------------------------------------------
# Vector Database Configuration
# -----------------------------------------------------------------------------
# Using PGVector - embeddings stored directly in PostgreSQL (no separate service needed)
VECTOR_DB_TYPE=pgvector  # pgvector, chromadb, or pinecone

# ChromaDB (Not used - replaced by PGVector)
# CHROMA_PERSIST_DIRECTORY=./data/chroma
# CHROMA_COLLECTION_NAME=document_chunks

# Pinecone (Production - uncomment and configure if using)
# PINECONE_API_KEY=your-pinecone-api-key
# PINECONE_ENVIRONMENT=us-west1-gcp
# PINECONE_INDEX_NAME=askmydocs

# -----------------------------------------------------------------------------
# File Storage Configuration
# -----------------------------------------------------------------------------
STORAGE_TYPE=local  # local or s3

# Local Storage (Development)
LOCAL_STORAGE_PATH=./data/documents
LOCAL_EXPORT_PATH=./data/exports

# AWS S3 (Production - uncomment and configure if using)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET=askmydocs-documents
# S3_EXPORT_BUCKET=askmydocs-exports

# -----------------------------------------------------------------------------
# Celery Task Queue Configuration
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TRACK_STARTED=True
CELERY_TASK_TIME_LIMIT=3600  # 1 hour in seconds

# -----------------------------------------------------------------------------
# Document Processing Configuration
# -----------------------------------------------------------------------------
# Maximum file size for uploads (in bytes)
MAX_UPLOAD_SIZE=104857600  # 100MB

# Supported file types
ALLOWED_FILE_TYPES=pdf,docx,pptx,xlsx,txt,md,jpg,png

# Chunking parameters
CHUNK_SIZE=1000  # characters
CHUNK_OVERLAP=200  # characters

# OCR Configuration
TESSERACT_PATH=/usr/bin/tesseract  # Path to tesseract executable
OCR_LANGUAGE=eng

# -----------------------------------------------------------------------------
# WebSocket Configuration
# -----------------------------------------------------------------------------
WS_HEARTBEAT_INTERVAL=30  # seconds
WS_MESSAGE_QUEUE_SIZE=100

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
ALLOWED_HEADERS=*

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json or text
LOG_FILE=./logs/app.log

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=100

# -----------------------------------------------------------------------------
# Email Configuration (Optional - for notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-app-password
SMTP_FROM=noreply@askmydocs.com

# -----------------------------------------------------------------------------
# Monitoring & Analytics (Optional)
# -----------------------------------------------------------------------------
# SENTRY_DSN=your-sentry-dsn
# ANALYTICS_ENABLED=True

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_DOCUMENT_AUTO_TAGGING=True
ENABLE_HITL=True  # Human-in-the-loop for complex queries
ENABLE_EXPORT_PDF=True
ENABLE_EXPORT_MARKDOWN=True
ENABLE_MCP_SERVER=False  # Model Context Protocol server

# -----------------------------------------------------------------------------
# Development & Testing
# -----------------------------------------------------------------------------
# Set to True to seed database with test data on startup
SEED_DATABASE=False

# Set to True to enable API documentation (Swagger/ReDoc)
ENABLE_DOCS=True
